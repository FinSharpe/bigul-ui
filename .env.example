# LangGraph Configuration
# The browser talks to LangGraph through this app's /api proxy, which needs a
# Bigul session. Local proxy mode: the app on :3000, `langgraph dev` on :2024.
NEXT_PUBLIC_API_URL=http://localhost:3000/api
LANGGRAPH_API_URL=http://localhost:2024
NEXT_PUBLIC_ASSISTANT_ID=agent
# Optional. Required for Agent Builder deployments.
# Set to "langsmith-api-key" when using a LangSmith PAT.
NEXT_PUBLIC_AUTH_SCHEME=
# Do NOT prefix this with "NEXT_PUBLIC_" as we do not want this exposed in the client.
# Optional: the /api proxy injects it only until bigul-backend's custom auth is
# deployed. Remove it from Vercel after that.
LANGSMITH_API_KEY=

# Production LangGraph Configuration (quickstart) - Uncomment to use
# NEXT_PUBLIC_ASSISTANT_ID="agent"
# This should be the deployment URL of your LangGraph server
# LANGGRAPH_API_URL="https://my-agent.default.us.langgraph.app"
# This should be the URL of your website + "/api". This is how you connect to the API proxy
# NEXT_PUBLIC_API_URL="https://my-website.com/api"

NEXT_PUBLIC_GITHUB_REPO_URL=https://github.com/FinSharpe/agent-chat-ui-template

# Bigul login. All server-only: never prefix these with NEXT_PUBLIC_.
# Session signing key (SECRET): RS256 private key, PKCS#8 PEM, either inline
# with literal \n escapes or base64-encoded in the _B64 variable. bigul-backend
# gets the matching public key as BIGUL_SESSION_PUBLIC_KEY. For a local pair
# (prints the env lines for both repos):
#   node scripts/generate-session-keys.mjs
BIGUL_SESSION_PRIVATE_KEY=
# BIGUL_SESSION_PRIVATE_KEY_B64=
# JWT iss/aud; must match bigul-backend. Defaults shown.
# BIGUL_SESSION_ISSUER=bigul-ui
# BIGUL_SESSION_AUDIENCE=bigul-backend
# Bigul Connect SSO. Register https://<site>/auth/callback with Bigul as the redirect URL.
# BIGUL_SSO_LOGIN_URL=https://connect.bigul.co/login
# Not secret: it appears in the browser's redirect to Bigul. Required. It is the
# Bigul Connect app's API key, the same value as BIGUL_API_KEY.
BIGUL_SSO_APP_KEY=
# Bigul partner API, called server-side to confirm each login. Production only
# accepts calls from whitelisted static IPs. The base URL includes /api/v1.
# UAT: https://servicestest.bigul.co/api/v1
# BIGUL_API_BASE_URL=https://papi.bigul.co/api/v1
# BIGUL_API_SOURCE=B2B
# How a login is verified: "profile" (default, GET get-client-profile) or
# "margin" (fallback: a one-share margin calculation, nothing placed).
# BIGUL_VERIFY_WITH=profile
# Secrets, all required (the partner login supplies the SSO sessionid):
BIGUL_API_KEY=
BIGUL_API_SECRET=
BIGUL_PARTNER_CODE=
BIGUL_PARTNER_PASSWORD=
# Optional, secret: relays with fixed IPs for the Bigul partner API calls only.
# Comma-separated HTTP proxy URLs, primary first, then secondary. Each relay must
# allow CONNECT to the Bigul API host on port 443. URL-encode special characters
# in the user name and password. Unset or blank: Bigul is called directly.
# BIGUL_OUTBOUND_PROXY_URLS=http://<user>:<password>@<primary-ip>:3128,http://<user>:<password>@<secondary-ip>:3128
# Local development only: "true" enables /auth/dev-login (sign in as any client
# code without Bigul) under `next dev`. Production builds ignore it.
AUTH_DEV_LOGIN=
